[Unit]
Description=WaterScribe Gunicorn
After=network.target postgresql.service

[Service]
User=rcampbell
Group=rcampbell
WorkingDirectory=/home/rcampbell/aquarium-tracker/aquarium-tracker
Environment="PATH=/home/rcampbell/aquarium-tracker/aquarium-tracker/venv/bin"
EnvironmentFile=/home/rcampbell/aquarium-tracker/aquarium-tracker/.env
ExecStart=/home/rcampbell/aquarium-tracker/aquarium-tracker/venv/bin/gunicorn --workers 3 --bind 127.0.0.1:5000 wsgi:app
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
