#!/usr/bin/env python3
"""Set the passphrase the /login page asks for. Run it yourself; it is never echoed or logged.
Usage: venv/bin/python set-passphrase [state dir]"""
import getpass, os, sys
from pathlib import Path
sys.path.insert(0, str(Path(__file__).resolve().parent))
from oauth import hash_passphrase

state = Path(sys.argv[1] if len(sys.argv) > 1 else
             os.environ.get('WATERSCRIBE_MCP_STATE', Path.home() / '.local/state/waterscribe-mcp'))
p = getpass.getpass('New passphrase (12+ chars): ')
if len(p) < 12:
    sys.exit('too short')
if getpass.getpass('Again: ') != p:
    sys.exit('did not match')
state.mkdir(parents=True, exist_ok=True, mode=0o700)
f = state / 'passphrase'
fd = os.open(f, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
with os.fdopen(fd, 'w') as out:
    out.write(hash_passphrase(p) + '\n')
print(f'saved (hashed) to {f}; restart not needed')
